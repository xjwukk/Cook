# 飞书开放平台应用凭证（仅在需要从飞书拉取菜谱时使用）
# 获取方式: https://open.feishu.cn/app
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 自托管账号服务
# SQLite 文件位置（相对 server 目录或绝对路径）
COOK_DB_PATH=data/cook.sqlite
# 首次启动时创建的管理员；已存在时只补角色，不覆盖密码
COOK_ADMIN_USERNAME=
COOK_ADMIN_PASSWORD=
# 注册邀请码；留空则关闭注册
COOK_INVITE_CODE=
# 通过 HTTPS 访问时设为 1，Cookie 会带 Secure
COOK_COOKIE_SECURE=0
# 允许调用写接口的来源，多个用逗号分隔（反向代理后的对外地址）
COOK_ALLOWED_ORIGINS=http://localhost:3000

# Web 站点对外地址（含协议），构建前设置；用于 canonical、OG 与 sitemap
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Microsoft Clarity：留空关闭统计
NUXT_PUBLIC_CLARITY_PROJECT_ID=
NUXT_PUBLIC_CLARITY_DOMAINS=

# 料理助手（服务端调用大模型）。COOK_AI_ENABLED=1 且填了 API Key 才会启用。
COOK_AI_ENABLED=0
# OpenAI 兼容端点；可换成任意兼容服务商的自定义地址
COOK_AI_BASE_URL=https://api.deepseek.com/v1
COOK_AI_MODEL=deepseek-chat
COOK_AI_API_KEY=
COOK_AI_TIMEOUT_MS=30000
# 单轮送入模型的候选菜谱上限
COOK_AI_MAX_CANDIDATES=50
# 每个账号每日 / 每分钟提问上限，0 表示不限制
COOK_AI_USER_DAILY_LIMIT=100
COOK_AI_USER_MINUTE_LIMIT=10
# 识图用的模型（可选）：留空表示跟随 COOK_AI_MODEL
COOK_AI_VISION_MODEL=
# 单轮最多上传几张图片、单张图片上限（字节）
COOK_AI_MAX_IMAGES=4
COOK_AI_MAX_IMAGE_BYTES=716800
