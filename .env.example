# 飞书开放平台应用凭证（仅在需要从飞书拉取菜谱时使用）
# 获取方式: https://open.feishu.cn/app
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 自托管账号服务
# SQLite 文件位置（相对 server 目录或绝对路径）
COOK_DB_PATH=data/cook.sqlite
# 首次启动时创建的管理员；已存在时只补角色，不覆盖密码
COOK_ADMIN_USERNAME=
COOK_ADMIN_PASSWORD=
# 注册邀请码；留空则关闭注册
COOK_INVITE_CODE=
# 通过 HTTPS 访问时设为 1，Cookie 会带 Secure
COOK_COOKIE_SECURE=0
# 允许调用写接口的来源，多个用逗号分隔（反向代理后的对外地址）
COOK_ALLOWED_ORIGINS=http://localhost:3000

# Web 站点对外地址（含协议），构建前设置；用于 canonical、OG 与 sitemap
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Microsoft Clarity：留空关闭统计
NUXT_PUBLIC_CLARITY_PROJECT_ID=
NUXT_PUBLIC_CLARITY_DOMAINS=
