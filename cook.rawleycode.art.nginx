server {
    server_name cook.rawleycode.art;

    client_max_body_size 10m;

    root /var/www/cook.rawleycode.art;
    index index.html;

    # 字体 CSS 与 woff2 都是文本/字体资源，gzip 后体积明显更小。
    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml;

    # 站点是 CSR 静态产物，hash 化的 _nuxt 资源可长期缓存。
    location /_nuxt/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        access_log off;
        try_files $uri =404;
    }

    # 字体：切片文件名暂时不带内容哈希，先用 30 天 + 必须重新验证；
    # 重新切分字体会换文件名，届时可以改成 1 年 immutable。
    location /fonts/ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, must-revalidate" always;
        access_log off;
        try_files $uri =404;
    }

    location /.well-known/ {
        expires 1h;
        access_log off;
        try_files $uri =404;
    }

    # 账号与同步接口交给 cook-server，不缓存。
    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        add_header Cache-Control "no-store" always;
    }

    location / {
        # index.html 不缓存，保证新版本发布后能立即拿到新的资源清单。
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }

    listen 80;
    listen [::]:80;
}
